VPN_API_BASE_URL=http://127.0.0.1:8089
VPN_API_KEY=ganti-dengan-key-dari-server
# JSON array opsional untuk beberapa server. Jika diisi, ini menggantikan dua variabel di atas.
VPN_API_SERVERS=[{"id":"vm1","label":"Server 1","location":"Jakarta, Indonesia","baseUrl":"https://api.example.com","apiKey":"ganti-key","dailyLimit":10,"capacity":150,"bandwidth":"Unlimited"}]
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
# Oracle NoSQL: use complete IAM values or configure an OCI config file/profile.
ORACLE_NOSQL_REGION=
ORACLE_NOSQL_COMPARTMENT=
ORACLE_NOSQL_TENANT_ID=
ORACLE_NOSQL_USER_ID=
ORACLE_NOSQL_FINGERPRINT=
ORACLE_NOSQL_PRIVATE_KEY=
ORACLE_NOSQL_PASSPHRASE=
ORACLE_NOSQL_CONFIG_FILE=
ORACLE_NOSQL_PROFILE=DEFAULT
ORACLE_NOSQL_TABLE=free_ovpn
# Login portal admin: jalankan `npm run hash:admin-password` untuk membuat hash dan secret sesi.
ADMIN_EMAILS=
ADMIN_PASSWORD_HASH=
ADMIN_SESSION_SECRET=
DAILY_LIMIT_PER_SERVICE=15
# Kuota per durasi, format "hari:limit" dipisah koma. Kunci harus sama persis dengan ALLOWED_DAYS.
# Default 1:4, 3:3, 7:3 → total 10 sama dengan DAILY_LIMIT_PER_SERVICE (tidak mengubah total).
QUOTA_PER_DURATION=1:5,3:5,7:5
ALLOWED_DAYS=1,3,7
PER_IP_CREATE_LIMIT_PER_HOUR=1
PER_IP_CREATE_LIMIT_PER_DAY=1
# Pilih firestore, oracle-nosql, atau memory. Kosong berarti Firestore bila semua FIREBASE_* diisi.
QUOTA_STORE=memory
# URL publik opsional untuk canonical dan metadata.
SITE_URL=
IP_HASH_SALT=ganti-dengan-string-acak-panjang
TRUST_PROXY_HEADERS=0
SUPPORT_URL=
FORCE_MAINTENANCE=0
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
VPN_API_GET_TIMEOUT_MS=8000
VPN_API_POST_TIMEOUT_MS=20000